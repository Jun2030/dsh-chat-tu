{
  "name": "dsh-tu-bubbles",
  "version": "0.2.0",
  "private": false,
  "description": "吐泡泡：本地优先的局域网 WebRTC 聊天插件（频道 / 表情 / 本地 SQLite）",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jun2030/dsh-chat-tu.git"
  },
  "homepage": "https://github.com/Jun2030/dsh-chat-tu#readme",
  "keywords": ["deepseek-harness", "dsh-plugin", "webrtc", "chat"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "test": "node test/store.test.mjs && node test/signaling.test.mjs && node test/election.test.mjs && node test/client.test.mjs && node test/registration.test.mjs && node test/regression.test.mjs"
  }
}
